# ==== Kafka ====
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_VOTE_REPORTS=vote_reports
KAFKA_TOPIC_AGGREGATED=aggregated_results
KAFKA_TOPIC_ANOMALIES=anomalies

# ==== PostgreSQL (aggregator writes here) ====
DATABASE_URL=postgresql://election:election@localhost:5432/elections

# ==== Ingestion API (Render) ====
# URL that simulators / the portal call
INGEST_URL=http://localhost:8000
# JSON map: station_id -> api key (stations must present X-Station-Key)
STATION_API_KEYS={"station-001":"key-001","station-002":"key-002","station-003":"key-003"}
# portal → ingestion shared secret (Authorization: Bearer <secret>)
INGEST_API_SECRET=dev-secret
# failover controller URL: GET {url}/active -> {"active_cloud":"azure"}
FAILOVER_URL=http://localhost:8002
# if failover controller is unreachable, trust this default active cloud
DEFAULT_ACTIVE_CLOUD=azure
# warns (does not block) if the decided cloud ≠ this primary
PRIMARY_CLOUD=azure

# ==== Failover controller (GCP VM) ====
PROMETHEUS_URL=http://localhost:9090
# monitor-up alerts must be named: <Cloud>Down with label cloud=<PRIMARY_CLOUD|STANDBY_CLOUD>
PRIMARY_CLOUD_NAME=azure
STANDBY_CLOUD_NAME=oracle

# ==== Metrics (Prometheus client, all services) ====
METRICS_PORT=9700

# ==== Dashboard API (Render) ====
# --- each service can in turn override its KAFKA_BROKERS: azure_ns | oracle_ns ...
DASHBOARD_API_PORT=8001
FRONTEND_ORIGIN=http://localhost:3100

# ==== Anomaly engine ---- anomaly webhook (Cloudflare Worker or direct bridge) ====
# engine also pushes anomalies to this URL (POST JSON), in addition to the Kafka topic
ANOMALY_WEBHOOK_URL=

# ==== Cloudflare Worker (set in wrangler dashboard or .dev.vars) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
